<%#
  一覧の 1 行。完了・未完了の切り替え、編集、削除のボタンを持つ。

  locals:
    todo - 表示する Todo。

  id は dom_id で `todo_<id>` にしている。Turbo の morphing は id で同じ要素を見分けるので、
  完了を切り替えても他の行はそのまま残る。
%>
<li id="<%= dom_id(todo) %>" class="flex items-center gap-3 px-4 py-3" data-completed="<%= todo.completed? %>">
  <%= button_to todo.completed? ? t(".undo") : t(".done"), todo_path(todo),
        method: :patch, params: { todo: { completed: !todo.completed? } },
        class: "w-14 cursor-pointer rounded-md border border-gray-300 px-2 py-1 text-xs hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800" %>
  <span class="<%= class_names("flex-1 break-words", "text-gray-400 line-through": todo.completed?) %>"><%= todo.title %></span>
  <%= link_to t(".edit"), edit_todo_path(todo), class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  <%= button_to t(".delete"), todo_path(todo), method: :delete,
        class: "cursor-pointer text-sm text-red-600 hover:underline dark:text-red-400" %>
</li>
